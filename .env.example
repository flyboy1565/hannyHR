DEBUG=True
SECRET_KEY=change-me-to-a-real-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# PostgreSQL settings (used when DB_ENGINE=postgres)
POSTGRES_DB=hannyhr
POSTGRES_USER=hannyhr
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gunicorn worker count (docker only)
GUNICORN_WORKERS=3

# Seed demo data on startup (set to True in docker-compose)
SEED_DEMO=False